# Keep secrets, local state, and build noise out of every image layer.
.env
.env.*
!.env.example

.git
.gitignore
.github

.venv
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Local runtime data belongs on a volume, never in an image.
local_data/
data-local/
chroma_data/
chroma_db/
*.sqlite
*.sqlite3
*.db
*.log

tests/
docs/
claudedocs/
.idea/
.vscode/
.DS_Store
