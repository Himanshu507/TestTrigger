# Copy to .env and fill in your own values. .env is git-ignored.
# Never commit a real key, and never move OPENAI_API_KEY to the frontend
# service: anything the frontend container receives is served to the browser.

# Backend only. Without it the service still starts; intent extraction and AI
# analysis are disabled and /health reports which features are off.
OPENAI_API_KEY=

# Model selection.
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local browser origin allowed by CORS. Must match where the UI is served.
FRONTEND_ORIGIN=http://localhost:5173

# API base URL the browser calls. Frontend container only.
API_BASE_URL=http://localhost:8000

# Below the threshold, a parsed request asks for clarification instead of running.
INTENT_CONFIDENCE_THRESHOLD=0.5

# Seconds before a model or embedding request is treated as timed out.
LLM_TIMEOUT_SECONDS=30
